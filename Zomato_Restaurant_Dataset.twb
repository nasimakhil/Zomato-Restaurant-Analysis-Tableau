      <aliases enabled='yes' />
      <column datatype='real' datatype-customized='true' name='[Aggregate rating]' role='measure' type='quantitative' />
      <column caption='Rating Bucket' datatype='string' name='[Calculation_0648211077775360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Aggregate rating] &gt;= 4.0 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [Aggregate rating] &gt;= 3.0 THEN &quot;Good&quot;&#13;&#10;ELSEIF [Aggregate rating] &gt;= 2.0 THEN &quot;Average&quot;&#13;&#10;ELSE &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Cost Bucket' datatype='string' name='[Calculation_0648211079933953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Average Cost for two] &lt;= 500 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Average Cost for two] &lt;= 1500 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='% Table Booking' datatype='real' default-format='p0.00%' name='[Calculation_0648211080257538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Has Table booking] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([Restaurant ID])' />
      </column>
      <column caption='% Online Delivery' datatype='real' default-format='p0.00%' name='[Calculation_0648211081699333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Has Online delivery] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([Restaurant ID])' />
      </column>
